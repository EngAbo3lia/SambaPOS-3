<Window x:Class="Samba.Presentation.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:cal="http://www.codeplex.com/CompositeWPF"
        xmlns:local="clr-namespace:Samba.Presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Samba Pos Shell" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        WindowState="Normal" SnapsToDevicePixels="True" Height="600" Width="800" Closing="WindowClosing" Loaded="WindowLoaded" Icon="/Samba.Presentation;component/apple.ico">
    <Window.Background>
        <DynamicResource ResourceKey="PosLiteWindowBackgroundBrush"/>
    </Window.Background>
    <Grid Name="MainGrid">
        <Grid.LayoutTransform>
            <ScaleTransform/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource PosLiteHeaderBackgroundBrush}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image Source="/Samba.Presentation;component/Images/apple-icon.png" Stretch="UniformToFill" Margin="0,0,0,2"></Image>
                    <TextBlock MouseWheel="UIElement_OnMouseWheel" Margin="12,0" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource PosLiteHeaderForegroundBrush}" MouseDown="TextBlockMouseDown" VerticalAlignment="Center">SambaPOS 3</TextBlock>
                </StackPanel>
                <Button Grid.Column="1" x:Name="ThemeToggleButton" Style="{StaticResource PosLiteGhostButton}"
                        Margin="0,0,12,0" Padding="12,6" FontSize="13"
                        Foreground="{DynamicResource PosLiteHeaderForegroundBrush}"
                        BorderBrush="#55FFFFFF" Click="ThemeToggleButton_Click"
                        ToolTip="Toggle Light/Dark Theme"/>
                <TextBlock Name="TimeLabel" Grid.Column="2" Margin="10,5,6,0" FontSize="16" Foreground="{DynamicResource PosLiteHeaderForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Lucida Console">SAAT</TextBlock>
            </Grid>
        </Border>

        <TabControl Style="{StaticResource BorderlessTabControlStyle}"
                    Margin="0" Padding="0" Grid.Row="1" Grid.ColumnSpan="2" cal:RegionManager.RegionName="MainRegion" SelectedIndex="0" Name="MainTabControl">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>
        </TabControl>

        <local:ToastHostControl Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource PosLiteFooterBackgroundBrush}">
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="FontSize" Value="16"/>
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0" cal:RegionManager.RegionName="UserRegion" Name="UserRegion" Background="Transparent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl Grid.Column="1" cal:RegionManager.RegionName="MessageRegion" Name="MessageRegion" Background="Transparent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl Grid.Column="3" cal:RegionManager.RegionName="RightUserRegion" Name="RightUserRegion" Background="Transparent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>